{
  "name": "vscode-portfolio",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24.18.1 <25"
  },
  "dependencies": {
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.17.0"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@babel/preset-env": "^7.26.0",
    "@babel/preset-react": "^7.26.0",
    "@vitejs/plugin-react": "^6.1.1",
    "babel-jest": "^29.7.0",
    "eslint": "^8.57.1",
    "eslint-plugin-react": "^7.37.4",
    "eslint-plugin-react-hooks": "^4.6.2",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "jest-watch-typeahead": "^2.2.2",
    "vite": "^8.2.2",
    "wrangler": "4.129.0"
  },
  "scripts": {
    "start": "vite",
    "prebuild": "npm run verify:resume",
    "build": "vite build",
    "verify:resume": "node scripts/verify-resume-assets.mjs",
    "test": "jest --watch",
    "test:ci": "jest --watchAll=false --coverage",
    "test:coverage": "jest --coverage --watchAll=false",
    "lint": "eslint src --ext .js,.jsx",
    "lint:fix": "eslint src --ext .js,.jsx --fix",
    "pre-commit": "npm run lint && npm run test:ci",
    "sbom": "node ../.github/scripts/generate-sbom.mjs sbom.cdx.json",
    "analyze": "npx vite-bundle-visualizer"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "workerd@1.20260903.1": true,
    "fsevents@2.3.3": true
  }
}
